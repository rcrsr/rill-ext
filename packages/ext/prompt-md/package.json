{
  "name": "@rcrsr/rill-ext-prompt-md",
  "version": "0.20.0",
  "description": "rill extension for loading markdown prompt files with frontmatter",
  "license": "MIT",
  "author": "Andre Bremer",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "keywords": [
    "rill",
    "prompt",
    "markdown",
    "frontmatter",
    "loader",
    "extension",
    "scripting"
  ],
  "rill": {
    "role": "extension"
  },
  "scripts": {
    "build": "tsup && dts-bundle-generator --config dts-bundle-generator.config.cjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --config ../../../.oxlintrc.json src/ tests/",
    "check": "pnpm run build && pnpm run test && pnpm run lint"
  },
  "peerDependencies": {
    "@rcrsr/rill": "~0.20.0"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@google/genai": "^2.18.0",
    "@rcrsr/rill": "~0.20.0",
    "@rcrsr/rill-ext-prompt-shared": "workspace:*",
    "@types/node": "^26.2.0",
    "dts-bundle-generator": "^9.5.1",
    "openai": "^7.5.0",
    "tsup": "^8.5.1",
    "undici-types": "^8.10.0"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rcrsr/rill-ext.git",
    "directory": "packages/ext/prompt-md"
  },
  "homepage": "https://github.com/rcrsr/rill-ext/tree/main/packages/ext/prompt-md#readme",
  "bugs": {
    "url": "https://github.com/rcrsr/rill-ext/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
