{
  "name": "@rcrsr/rill-ext-fs-local",
  "version": "0.21.0",
  "description": "rill extension for local filesystem operations with mount-based sandboxing",
  "license": "MIT",
  "author": "Andre Bremer",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "keywords": [
    "rill",
    "filesystem",
    "local",
    "fs",
    "sandbox",
    "extension",
    "scripting"
  ],
  "rill": {
    "role": "extension"
  },
  "scripts": {
    "build": "tsup && dts-bundle-generator --config dts-bundle-generator.config.cjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --config ../../../.oxlintrc.json src/ tests/",
    "check": "pnpm run build && pnpm run test && pnpm run lint"
  },
  "peerDependencies": {
    "@rcrsr/rill": "~0.23.0"
  },
  "devDependencies": {
    "@rcrsr/rill": "~0.23.0",
    "@rcrsr/rill-ext-fs-shared": "workspace:*",
    "@rcrsr/rill-ext-param-shared": "workspace:*",
    "@types/node": "^26.6.6",
    "dts-bundle-generator": "^9.5.1",
    "tsup": "^9.0.0",
    "undici-types": "^8.12.4"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rcrsr/rill-ext.git",
    "directory": "packages/ext/fs-local"
  },
  "homepage": "https://github.com/rcrsr/rill-ext/tree/main/packages/ext/fs-local#readme",
  "bugs": {
    "url": "https://github.com/rcrsr/rill-ext/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
