{
  "name": "@rcrsr/rill-ext-google-workspace",
  "version": "0.20.0",
  "description": "rill extension for Google Workspace (Gmail, Drive, Calendar) integration",
  "license": "MIT",
  "author": "Andre Bremer",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "keywords": [
    "rill",
    "google",
    "workspace",
    "gmail",
    "drive",
    "calendar",
    "extension",
    "ai",
    "scripting"
  ],
  "rill": {
    "role": "extension"
  },
  "scripts": {
    "build": "tsup && dts-bundle-generator --config dts-bundle-generator.config.cjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --config ../../../.oxlintrc.json src/ tests/",
    "check": "pnpm run build && pnpm run test && pnpm run lint"
  },
  "peerDependencies": {
    "@rcrsr/rill": "~0.20.0"
  },
  "devDependencies": {
    "@rcrsr/rill": "~0.20.0",
    "@rcrsr/rill-ext-param-shared": "workspace:^",
    "@types/node": "^26.4.1",
    "dts-bundle-generator": "^9.5.1",
    "tsup": "^8.5.1",
    "undici-types": "^8.10.0"
  },
  "files": [
    "dist",
    "docs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rcrsr/rill-ext.git",
    "directory": "packages/ext/google-workspace"
  },
  "homepage": "https://github.com/rcrsr/rill-ext/tree/main/packages/ext/google-workspace#readme",
  "bugs": {
    "url": "https://github.com/rcrsr/rill-ext/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
