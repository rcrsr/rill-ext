{
  "$schema": "https://cdn.jsdelivr.net/npm/@rcrsr/rill@latest/schema/rill-config.schema.json",
  "name": "calendar-scheduling-example",
  "version": "0.1.0",
  "description": "Run a free/busy query and create a Calendar event",
  "main": "script.rill",
  "extensions": {
    "mounts": {
      "gw": "@rcrsr/rill-ext-google-workspace"
    },
    "config": {
      "gw": {
        "auth": {
          "type": "bearer",
          "token": "${GOOGLE_TOKEN}"
        },
        "capabilities": {
          "calendar": { "create": true }
        }
      }
    }
  },
  "context": {
    "schema": {
      "title": { "type": "string" },
      "start": { "type": "string" },
      "end": { "type": "string" },
      "attendees": { "type": "string" }
    },
    "values": {
      "title": "Team Sync",
      "start": "${CAL_START}",
      "end": "${CAL_END}",
      "attendees": "alice@example.com,bob@example.com"
    }
  }
}
