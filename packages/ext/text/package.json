{
  "name": "@rcrsr/rill-ext-text",
  "version": "0.21.0",
  "description": "rill extension for text processing (HTML-to-text, Markdown conversion, web content extraction, segmentation, MIME, Unicode)",
  "license": "MIT",
  "author": "Andre Bremer",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "keywords": [
    "rill",
    "text",
    "html",
    "markdown",
    "extract",
    "segment",
    "mime",
    "unicode",
    "extension",
    "scripting"
  ],
  "rill": {
    "role": "extension"
  },
  "scripts": {
    "build": "tsup && dts-bundle-generator --config dts-bundle-generator.config.cjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --config ../../../.oxlintrc.json src/ tests/",
    "check": "pnpm run build && pnpm run test && pnpm run lint"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "peerDependencies": {
    "@rcrsr/rill": "~0.23.0"
  },
  "dependencies": {
    "defuddle": "^0.19.6",
    "entities": "^9.0.0",
    "html-to-text": "^10.0.1",
    "linkedom": "^0.18.15",
    "linkify-it": "^6.1.0",
    "turndown": "^7.2.5"
  },
  "devDependencies": {
    "@rcrsr/rill": "~0.23.0",
    "@rcrsr/rill-ext-param-shared": "workspace:*",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^26.6.6",
    "@types/turndown": "^5.0.6",
    "dts-bundle-generator": "^9.5.1",
    "tsup": "^9.0.0",
    "undici-types": "^8.12.4"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rcrsr/rill-ext.git",
    "directory": "packages/ext/text"
  },
  "homepage": "https://github.com/rcrsr/rill-ext/tree/main/packages/ext/text#readme",
  "bugs": {
    "url": "https://github.com/rcrsr/rill-ext/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
