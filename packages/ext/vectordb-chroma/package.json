{
  "name": "@rcrsr/rill-ext-chroma",
  "version": "0.19.1",
  "description": "rill extension for ChromaDB vector database integration",
  "license": "MIT",
  "author": "Andre Bremer",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "keywords": [
    "rill",
    "chroma",
    "chromadb",
    "vector-database",
    "vector-search",
    "extension",
    "ai",
    "scripting"
  ],
  "rill": {
    "role": "extension"
  },
  "scripts": {
    "build": "tsup && dts-bundle-generator --config dts-bundle-generator.config.cjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --config ../../../.oxlintrc.json src/",
    "check": "pnpm run build && pnpm run test && pnpm run lint"
  },
  "peerDependencies": {
    "@rcrsr/rill": "~0.19.0"
  },
  "devDependencies": {
    "@rcrsr/rill": "~0.19.0",
    "@rcrsr/rill-ext-param-shared": "workspace:^",
    "@rcrsr/rill-ext-vector-shared": "workspace:^",
    "@types/node": "^26.1.1",
    "dts-bundle-generator": "^9.5.1",
    "tsup": "^8.5.1",
    "undici-types": "^8.7.0"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rcrsr/rill-ext.git",
    "directory": "packages/ext/vectordb-chroma"
  },
  "homepage": "https://github.com/rcrsr/rill-ext/tree/main/packages/ext/vectordb-chroma#readme",
  "bugs": {
    "url": "https://github.com/rcrsr/rill-ext/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "chromadb": "^3.5.0"
  }
}
