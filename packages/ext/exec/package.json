{
  "name": "@rcrsr/rill-ext-exec",
  "version": "0.23.0",
  "description": "rill extension for sandboxed command execution",
  "license": "MIT",
  "author": "Andre Bremer",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "keywords": [
    "rill",
    "exec",
    "command",
    "process",
    "sandbox",
    "extension",
    "scripting"
  ],
  "rill": {
    "role": "extension"
  },
  "scripts": {
    "build": "tsup && dts-bundle-generator --config dts-bundle-generator.config.cjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --config ../../../.oxlintrc.json src/ tests/",
    "check": "pnpm run build && pnpm run test && pnpm run lint"
  },
  "peerDependencies": {
    "@rcrsr/rill": "~0.23.0"
  },
  "devDependencies": {
    "@rcrsr/rill": "~0.23.0",
    "@types/node": "^26.6.6",
    "dts-bundle-generator": "^9.5.1",
    "tsup": "^9.0.0",
    "undici-types": "^8.12.4"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rcrsr/rill-ext.git",
    "directory": "packages/ext/exec"
  },
  "homepage": "https://github.com/rcrsr/rill-ext/tree/main/packages/ext/exec#readme",
  "bugs": {
    "url": "https://github.com/rcrsr/rill-ext/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
