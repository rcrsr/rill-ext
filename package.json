{
  "name": "rill-ext",
  "version": "0.21.0",
  "description": "rill extension ecosystem — official extensions for rill",
  "private": true,
  "packageManager": "pnpm@12.9.1+sha512.06b055fff5cd20dc12781de173ced3310ce0951bf2ec620211a16045d5444d5c93a663210764ef29a653a610459ba0368f0e74f84d80c54723cf95aae7bc0d6d",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rcrsr/rill-ext.git"
  },
  "bugs": {
    "url": "https://github.com/rcrsr/rill-ext/issues"
  },
  "homepage": "https://github.com/rcrsr/rill-ext#readme",
  "scripts": {
    "prepare": "lefthook install --force",
    "bootstrap": "bash scripts/bootstrap.sh",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "test:rules": "rill-test-rules",
    "check:types": "pnpm -r run typecheck",
    "check:lint": "pnpm -r run lint",
    "check:format": "oxfmt --check",
    "check:deps": "knip",
    "check:standards": "rill-check-standards",
    "check:versions": "bash scripts/check-versions.sh",
    "check:changelog": "bash scripts/check-changelog-coverage.sh",
    "fix:lint": "oxlint --fix",
    "fix:format": "oxfmt",
    "fix:versions": "bash scripts/sync-versions.sh",
    "check": "pnpm run check:versions && pnpm run build && pnpm run check:types && pnpm run check:lint && pnpm run check:format && pnpm run check:deps && pnpm run test:rules && pnpm run test && pnpm run check:standards"
  },
  "author": "Andre Bremer",
  "license": "MIT",
  "engines": {
    "node": ">=22.16.0",
    "pnpm": ">=12"
  },
  "devDependencies": {
    "@rcrsr/rill-dev": "^0.2.6",
    "@types/node": "^26.6.4",
    "knip": "^6.39.0",
    "lefthook": "^2.1.16",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
